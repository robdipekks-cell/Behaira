local Rarities = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Secret"}
local Mutations = {"Normal", "Golden", "Diamond", "Ruby", "Neon", "Rich"}
local Units = {
    ["Common"] = {"Mr. Tanaka", "Mr. Chen", "Mr. Wong", "Mr. Kim", "Mr. Park", "Mr. Singh", "What the ?", "Mr. Lu", "Mr. Khan", "Jackie Chen"},
    ["Uncommon"] = {"Uncle Kantai", "Buddha", "Abbot", "McRonald", "Colonel", "Uncle Einstein", "Uncle Jackson", "Uncle Lu", "Uncle Rock"},
    ["Rare"] = {"Uncle Mike", "Most wanted uncle", "Uncle Eric", "Someone's father", "Mr. Billy", "Mr. Koi", "Uncle Koi"},
    ["Epic"] = {"Sir Girafee", "Uncle Tokugawa", "Uncle Pirate", "Alien", "Uncle Juntaro", "Mr. Musk", "Sensai B.C", "Dora A Man"},
    ["Legendary"] = {"Uncle Dave", "Mr. Pea", "Mr. Piranha Plant", "Uncle Gecko", "Uncle Fuk"},
    ["Mythical"] = {"Quadruplets", "Dr. Tesla", "Your highness", "Sir Adam", "Mr. P Peach"},
    ["Secret"] = {"Dr. Hu (Who?)", "Mr. Dalek"}
}

local function FireUnitRemote(unit, mutation, rarity)
    local args = {
        [1] = unit,
        [2] = mutation,
        [3] = rarity
    }
    game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RewardEscape"):FireServer(unpack(args))
end

