---------------------------------------------------------

-- Main Bypass Tab
local MainTab = Window:CreateTab("Bypass", 4483362458) -- Info icon

MainTab:CreateSection("Main Settings")

MainTab:CreateToggle({
   Name = "Hook Units",
   CurrentValue = false,
   Flag = "HookEnabled",
   Callback = function(Value)
      _G.HookEnabled = Value
   end,
})

MainTab:CreateLabel("Welcome, " .. Player.Name)
MainTab:CreateParagraph({Title = "Status", Content = "Whitelist Verified. Access Granted."})

-- Generate Tabs for each Rarity
for _, rarity in ipairs(Rarities) do
    local Tab = Window:CreateTab(rarity, 4483345906) -- Layers icon
    
    local SelectedUnit = Units[rarity][1]
    local SelectedMutation = "Normal"

    Tab:CreateDropdown({
       Name = "Select Unit",
       Options = Units[rarity],
       CurrentOption = {Units[rarity][1]},
       MultipleOptions = false,
       Flag = rarity .. "Unit",
       Callback = function(Option)
          SelectedUnit = Option[1]
       end,
    })

    Tab:CreateDropdown({
       Name = "Select Mutation",
       Options = Mutations,
       CurrentOption = {"Normal"},
       MultipleOptions = false,
       Flag = rarity .. "Mutation",
       Callback = function(Option)
          SelectedMutation = Option[1]
       end,
    })

    Tab:CreateButton({
       Name = "Execute " .. rarity,
       Callback = function()
          if _G.HookEnabled then
              FireUnitRemote(SelectedUnit, SelectedMutation, rarity)
              Rayfield:Notify({
                 Title = "Executed",
                 Content = "Fired: " .. SelectedUnit .. " (" .. SelectedMutation .. ")",
                 Duration = 3,
                 Image = 4483345906,
              })
          else
              Rayfield:Notify({
                 Title = "Action Denied",
                 Content = "Please enable 'Hook Units' in the Bypass tab first.",
                 Duration = 3,
                 Image = 4483362458,
              })
          end
       end,
    })
end
